# 复制为 apps/web/.env.local 后填写（全部可选，缺省自动降级到免密钥数据源）

# Cesium ion token —— 启用 Cesium World Terrain 地形 + Bing 影像
# 免费注册: https://ion.cesium.com/
VITE_CESIUM_ION_TOKEN=

# 天地图开发者 key —— 启用天地图影像/矢量底图（中国大陆直连，免费注册）
# 申请: https://console.tianditu.gov.cn/api/key
VITE_TDT_KEY=

# 地理编码服务（默认官方 Nominatim，可换自建 Photon 实例）
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
